{%- comment -%}
  Found desktop navigation ("G")
  ------------------------------
  Rendered inside the header section on desktop widths (1008px and up) when the
  header's "Quick-links header" setting is on. Below 1008px it is hidden and the
  theme's own mobile header and sidebar drawer stay exactly as they are.

  Closed:  wordmark left · up to eight quick links centred (label rolls on hover) · burger right.
  Closed and open: search and bag are small icons at the right of the bar, a dot on the bag
           when it holds something; currency and Account sit at the foot of the panel's index column.
  Open:    quick links stay put and become the group selectors; the page dims; a panel drops
           from the header with the hovered group's sections centred under the bar, six products
           (or articles for a blog) across the full width, and a hairline strip across the foot with the secondary pages left and currency and Account right.
           Clicks are reported to GA4 and Shopify customer events.

  Accepts: section (the header section).
{%- endcomment -%}

{%- liquid
  assign main_menu_handle = section.settings.navigation_menu | default: 'main-menu'
  assign main_menu = linklists[main_menu_handle]
  assign quick_handle = section.settings.quick_links_menu | default: main_menu_handle
  if quick_handle == main_menu_handle and linklists['quick-links'].links.size > 0
    assign quick_handle = 'quick-links'
  endif
  assign quick_menu = linklists[quick_handle]
  if quick_menu.links.size == 0
    assign quick_menu = main_menu
  endif
  assign shelf_size = 6
-%}

<div class="FoundNav" data-found-nav>
  <a href="{{ routes.root_url }}" class="FoundNav__Logo">
    {%- if section.settings.logo != blank -%}
      {%- capture image_size -%}{{ section.settings.logo_max_width }}x{%- endcapture -%}
      <img class="FoundNav__LogoImage" src="{{ section.settings.logo | img_url: image_size }}" srcset="{{ section.settings.logo | img_url: image_size }} 1x, {{ section.settings.logo | img_url: image_size, scale: 2 }} 2x" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" alt="{{ section.settings.logo.alt | default: shop.name | escape }}">
    {%- else -%}
      <span class="FoundNav__Wordmark">{{ shop.name }}</span>
    {%- endif -%}
  </a>

  <nav class="FoundNav__Quick" aria-label="{{ 'header.navigation.title' | t }}">
    {%- for link in quick_menu.links limit: 8 -%}
      {%- comment -%} A quick link that matches a main-menu group by URL also selects that group's sections and shelf in the open panel. {%- endcomment -%}
      {%- assign quick_group = '' -%}
      {%- for main_link in main_menu.links -%}
        {%- if main_link.url == link.url -%}{%- assign quick_group = forloop.index | prepend: 'g' -%}{%- endif -%}
      {%- endfor -%}
      <a href="{{ link.url }}" class="FoundNav__QuickLink" {% if quick_group != '' %}data-group="{{ quick_group }}"{% endif %}><span class="FoundNav__Roll"><span>{{ link.title | escape }}</span><span aria-hidden="true">{{ link.title | escape }}</span></span></a>
    {%- endfor -%}
  </nav>

  <div class="FoundNav__Right">
    <div class="FoundNav__Icons">
      <a href="{{ routes.search_url }}" class="FoundNav__Icon" data-action="toggle-search" aria-label="{{ 'header.navigation.search' | t }}"><svg viewBox="0 0 21 21" aria-hidden="true"><g transform="translate(1 1)" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"><path d="M18 18l-5.7-5.7"/><circle cx="7.5" cy="7.5" r="7.5"/></g></svg></a>
      <a href="{{ routes.cart_url }}" class="FoundNav__Icon FoundNav__Icon--cart" {% unless template == 'cart' or settings.cart_type == 'page' %}data-action="open-drawer" data-drawer-id="sidebar-cart" aria-expanded="false"{% endunless %} aria-label="{{ 'header.navigation.open_cart' | t }}"><svg viewBox="0 0 17 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.5 6.5h14l-1 12h-12z"/><path d="M5.5 6V4.5a3 3 0 016 0V6"/></svg><span class="FoundNav__CartDot Header__CartDot {% if cart.item_count > 0 %}is-visible{% endif %}"></span><span class="Header__CartCount u-visually-hidden">{{ cart.item_count }}</span></a>
    </div>
    <button type="button" class="FoundNav__Burger" data-found-toggle aria-expanded="false" aria-controls="FoundPanel-{{ section.id }}" aria-label="{{ 'header.navigation.open_sidebar' | t }}"><span></span><span></span></button>
  </div>
</div>

<div class="FoundPanel" id="FoundPanel-{{ section.id }}" aria-hidden="true" data-found-panel data-active="g1">
  <div class="FoundPanel__Subs">
    {%- for link in main_menu.links -%}
      {%- if link.links.size > 0 -%}
        <div class="FoundPanel__Sub" data-for="g{{ forloop.index }}">
          {%- for sub_link in link.links -%}
            <a href="{{ sub_link.url }}">{{ sub_link.title | escape }}</a>
            {%- comment -%} The store's menu nests a third level (Bags › All bags › Bag charms); show it in the same list. {%- endcomment -%}
            {%- for sub_sub_link in sub_link.links -%}
              <a href="{{ sub_sub_link.url }}">{{ sub_sub_link.title | escape }}</a>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="FoundPanel__Shelves">
    {%- for link in main_menu.links -%}
      {%- assign group_index = forloop.index -%}
      {%- if link.type == 'collection_link' and link.object != blank -%}
        {%- assign shelf_collection = link.object -%}
        <div class="FoundPanel__Shelf" data-for="g{{ group_index }}">
          {%- assign rendered = 0 -%}
          {%- for product in shelf_collection.products limit: 40 -%}
            {%- if product.available and rendered < shelf_size -%}
              {%- assign rendered = rendered | plus: 1 -%}
              {%- render 'found-nav-card', product: product, index: rendered -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if rendered < shelf_size -%}
            {%- for product in shelf_collection.products limit: 40 -%}
              {%- if product.available == false and rendered < shelf_size -%}
                {%- assign rendered = rendered | plus: 1 -%}
                {%- render 'found-nav-card', product: product, sold: true, index: rendered -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- elsif link.type == 'blog_link' and link.object != blank -%}
        <div class="FoundPanel__Shelf" data-for="g{{ group_index }}">
          {%- for article in link.object.articles limit: shelf_size -%}
            <a class="FoundPanel__Article" href="{{ article.url }}" style="--i: {{ forloop.index0 }}">
              <span class="FoundPanel__ArticleImg">{%- if article.image -%}<img data-src="{{ article.image | img_url: '600x450', crop: 'center' }}" alt="" width="600" height="450">{%- endif -%}</span>
              <span class="FoundPanel__ArticleTitle">{{ article.title | escape }}</span>
              <span class="FoundPanel__ArticleRead">{{ 'blog.article.read_more' | t }} →</span>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>



  {%- comment -%} Full-width strip: main-menu links without a quick link (Personal shopping, Contact) left; currency and Account right. {%- endcomment -%}
  <div class="FoundPanel__Strip">
    <div class="FoundPanel__StripLinks">
      {%- for main_link in main_menu.links -%}
        {%- assign in_quick = false -%}
        {%- for q in quick_menu.links limit: 8 -%}{%- if q.url == main_link.url -%}{%- assign in_quick = true -%}{%- endif -%}{%- endfor -%}
        {%- unless in_quick -%}<a href="{{ main_link.url }}">{{ main_link.title | escape }}</a>{%- endunless -%}
      {%- endfor -%}
    </div>
    <div class="FoundPanel__StripUtils">
    {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
        {%- form 'localization', id: 'FoundNavLocalizationPanel', class: 'FoundNav__Currency' -%}
          <label for="FoundNavCountryPanel" class="u-visually-hidden">{{ 'header.general.country' | t }}</label>
          <span class="FoundNav__CurrencyLabel" aria-hidden="true">{{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}<i></i></span>
          <select id="FoundNavCountryPanel" name="country_code" class="FoundNav__CurrencySelect" onchange="this.form.submit()">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="FoundPanel__Account">{{ 'header.navigation.account' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</div>
<div class="FoundBackdrop" data-found-backdrop aria-hidden="true"></div>

<style>
  /*
    Transparency is driven by this snippet's own script, not by the theme's: the header stays clear until the
    content below the hero (or the collection banner) scrolls up to meet it, on every screen size, and hovering
    or focusing the header never turns it solid. The theme's Header--transparent class is ignored here.
  */
  .supports-sticky .Search[aria-hidden="true"] + .Header--found.Header--foundClear:not(.Header--foundOpen) {
    background: transparent !important;
    box-shadow: none !important;
    color: {{ section.settings.transparent_text_color | default: '#ffffff' }};
  }
  .supports-sticky .Search[aria-hidden="true"] + .Header--found.Header--foundClear:not(.Header--foundOpen) .Header__Icon,
  .supports-sticky .Search[aria-hidden="true"] + .Header--found.Header--foundClear:not(.Header--foundOpen) .Header__LogoLink > .Heading,
  .supports-sticky .Search[aria-hidden="true"] + .Header--found.Header--foundClear:not(.Header--foundOpen) .FoundNav { color: currentColor; }
  .supports-sticky .Search[aria-hidden="true"] + .Header--found.Header--foundClear:not(.Header--foundOpen) .Header__Icon svg { filter: drop-shadow(0 1px rgba(0, 0, 0, 0.25)); }
  .Header--found:not(.Header--foundClear) { background: var(--header-background); }

  .FoundNav, .FoundPanel, .FoundBackdrop, .FoundSearch__Hint, .FoundSearch__Row { display: none; }

  @media screen and (min-width: 1008px) {
    /* The theme's own desktop header rows step aside; the mobile header below 1008px is untouched. */
    .Header--found .Header__Wrapper,
    .Header--found .Header__MainNav { display: none !important; }

    .FoundNav {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 92px;
      padding: 0 50px;
      color: var(--header-heading-color);
      font-family: var(--heading-font-family);
      font-weight: 500;
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      transition: color 0.3s ease-in-out;
    }

    .FoundNav__Logo { color: inherit; text-decoration: none; display: inline-flex; align-items: center; }
    .FoundNav__Wordmark { font-size: 16px; letter-spacing: 0.2em; }
    .FoundNav__LogoImage { max-height: 40px; width: auto; }

    .FoundNav__Quick {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      gap: 30px;
      white-space: nowrap;
    }

    .Header--foundOpen .FoundNav__QuickLink.is-active .FoundNav__Roll > span:first-child { opacity: 1; }
    @media screen and (max-width: 1240px) { .FoundNav__Quick { gap: 20px; } .FoundNav__QuickLink { font-size: 11px; letter-spacing: 0.16em; } }
    @media screen and (max-width: 1120px) { .FoundNav__Quick { gap: 15px; } .FoundNav__QuickLink { letter-spacing: 0.13em; } }

    .FoundNav__QuickLink { color: inherit; text-decoration: none; line-height: 1; }

    /* Label roll, measured from Forma: both copies move together over ~380ms on a late ease-in-out; the
       resting word is dimmed, the arriving twin is full strength. */
    .FoundNav__Roll { display: inline-block; position: relative; overflow: hidden; height: 1.1em; vertical-align: top; }
    .FoundNav__Roll > span { display: block; height: 1.1em; line-height: 1.1em; transition: transform 380ms cubic-bezier(0.7, 0, 0.2, 1); }
    .FoundNav__Roll > span:first-child { opacity: 0.75; }
    .FoundNav__QuickLink:hover .FoundNav__Roll > span,
    .FoundNav__QuickLink:focus-visible .FoundNav__Roll > span { transform: translateY(-100%); }

    .FoundNav__Right { display: flex; align-items: center; gap: 28px; }
    /* Search and bag only, drawn at the capitals' weight, one 28px rhythm through to the burger. */
    .FoundNav__Icons { display: flex; align-items: center; gap: 28px; }
    .FoundNav__Icon { position: relative; display: inline-flex; align-items: center; color: inherit; line-height: 0; transition: opacity 200ms; }
    .FoundNav__Icon svg { width: 15px; height: 15px; }
    .FoundNav__Icon:hover { opacity: 0.7; }
    .FoundNav__CartDot { position: absolute; top: -3px; right: -4px; width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: 0; transition: opacity 200ms; }
    .FoundNav__CartDot.is-visible { opacity: 1; }
    /* The quick links keep their place when the panel opens, so currency, Account and Cart sit on the panel's first row, right-aligned, level with the centred sections. */
    .FoundNav__Utility { color: inherit; text-decoration: none; }

    /* A hairline strip across the foot of the panel: secondary pages left in grey, currency and Account right. */
    .FoundPanel__Strip { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-top: 26px; padding-top: 16px; border-top: 1px solid var(--header-border-color); font-family: var(--heading-font-family); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; }
    .FoundPanel__StripLinks, .FoundPanel__StripUtils { display: flex; align-items: center; gap: 24px; }
    .FoundPanel__StripLinks a { color: var(--text-color-light); text-decoration: none; }
    .FoundPanel__StripLinks a:hover, .FoundPanel__Account:hover, .FoundNav__Currency:hover { color: var(--text-color-light); }
    .FoundNav__Currency { position: relative; display: inline-flex; align-items: center; color: var(--header-heading-color); }
    .FoundPanel__Account { color: var(--header-heading-color); text-decoration: none; }
    .FoundPanel__StripLinks a:hover { color: var(--header-heading-color); }
    .FoundNav__CurrencyLabel { display: inline-flex; align-items: center; gap: 6px; }
    .FoundNav__CurrencyLabel i { width: 6px; height: 6px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(45deg) translateY(-2px); }
    .FoundNav__CurrencySelect { position: absolute; inset: 0; width: 100%; opacity: 0; cursor: pointer; font-size: 16px; }

    .FoundNav__Burger { display: inline-flex; flex-direction: column; justify-content: center; gap: 5px; width: 31px; height: 31px; padding: 8px; margin-right: -8px; background: transparent; border: 0; color: inherit; cursor: pointer; }
    .FoundNav__Burger span { display: block; height: 1px; background: currentColor; transform-origin: right center; transition: transform 380ms cubic-bezier(0.2, 0.7, 0.2, 1); }
    .FoundNav__Burger:hover span:nth-child(1) { transform: translateX(3px) scaleX(0.82); }
    .FoundNav__Burger:hover span:nth-child(2) { transform: translateX(-3px); }
    .Header--foundOpen .FoundNav__Burger span { transform-origin: center; }
    .Header--foundOpen .FoundNav__Burger span:nth-child(1),
    .Header--foundOpen .FoundNav__Burger:hover span:nth-child(1) { transform: translateY(3px) rotate(45deg); }
    .Header--foundOpen .FoundNav__Burger span:nth-child(2),
    .Header--foundOpen .FoundNav__Burger:hover span:nth-child(2) { transform: translateY(-3px) rotate(-45deg); }
    .FoundNav__Burger:focus-visible { outline: 1px solid currentColor; outline-offset: 3px; }

    /* Panel */
    .FoundPanel {
      display: block;
      position: absolute;
      top: 0; left: 0; right: 0;
      z-index: 1;
      padding: 104px 50px 28px;
      background: rgba(255, 255, 255, 0.97);
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
      color: var(--header-heading-color);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
      transform: translateY(-100%);
      visibility: hidden;
      transition: transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s 520ms;
    }
    .Header--foundOpen .FoundPanel { transform: none; visibility: visible; transition: transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1); }
    .Header--foundOpen { background: transparent; box-shadow: none; }
    .FoundPanel--quick .FoundPanel__Shelf.is-shown .FoundPanel__Card,
    .FoundPanel--quick .FoundPanel__Shelf.is-shown .FoundPanel__Article { animation-duration: 220ms; animation-delay: 0ms; }

    /* The page below dims while the panel is open; a click or a cursor resting on it closes the panel. */
    .FoundBackdrop { display: block; position: fixed; inset: 0; z-index: 0; background: rgba(20, 18, 16, 0.32); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 420ms ease, visibility 0s 420ms; }
    .Header--foundOpen .FoundBackdrop { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity 420ms ease; }



    /* The hovered group's sections, centred under the bar; the shelves below, full width; "See all" centred under them. */
    .FoundPanel__Subs { display: grid; min-height: 41px; padding-bottom: 30px; } /* border-box: one 11px row of links plus the padding, so groups without sections keep the same panel height */
    .FoundPanel__Sub { display: none; grid-area: 1 / 1; justify-content: center; flex-wrap: wrap; gap: 10px 30px; }
    .FoundPanel__Sub.is-shown { display: flex; }
    .FoundPanel__Sub a { font-family: var(--heading-font-family); font-size: 11px; line-height: 1; letter-spacing: 0.18em; text-transform: uppercase; color: var(--header-heading-color); text-decoration: none; }
    .FoundPanel__Sub a:first-child { color: var(--text-color-light); }
    .FoundPanel__Sub a:hover { color: var(--header-heading-color); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }

    /* Every shelf occupies the same grid cell, so the row is always as tall as the tallest shelf and the bottom edge never jumps between groups. */
    .FoundPanel__Shelves { display: grid; }

    /* Card hover: the image eases in, the name underlines and the brand line lifts, so the card reads as a link. */
    .FoundPanel__Card:hover .FoundPanel__CardName, .FoundPanel__Article:hover .FoundPanel__ArticleTitle { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .FoundPanel__Card:hover .FoundPanel__CardPrice, .FoundPanel__Article:hover .FoundPanel__ArticleRead { color: var(--header-heading-color); }
    .FoundPanel__CardPrice, .FoundPanel__ArticleRead { transition: color 200ms; }
    /* A full row of ten products always fits the panel width; the cards share the space and grow with the screen. */
    .FoundPanel__Shelf { display: grid; grid-area: 1 / 1; visibility: hidden; grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: start; align-content: start; gap: 16px; }
    .FoundPanel__Shelf.is-shown { visibility: visible; }

    .FoundPanel__Card, .FoundPanel__Article { display: grid; gap: 4px; color: var(--header-heading-color); text-decoration: none; min-width: 0; opacity: 0; }
    .FoundPanel__Shelf.is-shown .FoundPanel__Card, .FoundPanel__Shelf.is-shown .FoundPanel__Article { animation: FoundPanel-rise 480ms cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i, 0) * 45ms); }
    @keyframes FoundPanel-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

    .FoundPanel__CardImg, .FoundPanel__ArticleImg { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: linear-gradient(100deg, var(--light-background) 30%, #ffffff 50%, var(--light-background) 70%); background-size: 200% 100%; animation: FoundPanel-shimmer 1.4s linear infinite; }
    .FoundPanel__ArticleImg { aspect-ratio: 4 / 3; }
    .is-loaded > .FoundPanel__CardImg, .is-loaded > .FoundPanel__ArticleImg { animation: none; background: var(--light-background); }
    @keyframes FoundPanel-shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
    .FoundPanel__CardImg img, .FoundPanel__ArticleImg img { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 400ms ease, transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1); }
    .is-loaded > .FoundPanel__CardImg img, .is-loaded > .FoundPanel__ArticleImg img { opacity: 1; }
    .FoundPanel__Card:hover .FoundPanel__CardImg img, .FoundPanel__Article:hover .FoundPanel__ArticleImg img { transform: scale(1.04); }
    .FoundPanel__CardSold { position: absolute; top: 8px; left: 8px; z-index: 1; background: #ffffff; padding: 4px 8px; font-family: var(--heading-font-family); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; }
    .FoundPanel__Card--sold .FoundPanel__CardImg img { opacity: 0.75; }
    .FoundPanel__CardName, .FoundPanel__ArticleTitle { margin-top: 8px; font-family: var(--heading-font-family); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .FoundPanel__ArticleTitle { line-height: 1.4; }
    .FoundPanel__CardPrice { font-size: 11px; color: var(--text-color-light); }
    .FoundPanel__ArticleRead { font-family: var(--heading-font-family); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-color-light); }
  }

  /* Wide screens: the header grows in step with the hero (same gutter formula as hero-search.liquid). */
  @media screen and (min-width: 1920px) {
    .FoundNav { padding: 0 clamp(50px, 3vw, 110px); font-size: clamp(12px, 0.5vw, 14px); height: clamp(92px, 3.6vw, 112px); }
    .FoundNav__Wordmark { font-size: clamp(16px, 0.7vw, 20px); }
    .FoundNav__Quick { gap: clamp(30px, 1.5vw, 46px); }
    .FoundPanel { padding: clamp(104px, 4vw, 124px) clamp(50px, 3vw, 110px) 28px; }
  }

  /*
    Desktop search, in the panel's clothes: the theme's overlay becomes the same white sheet, with a centred
    underline field, a rotating "Search for …" hint while empty, and results as the panel's six-card row.
    Phones and tablets keep the theme's own search untouched.
  */
  @media screen and (min-width: 1008px) {
    .shopify-section--header .Search { background: rgba(255, 255, 255, 0.97); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25); transform: translateY(-12px); }
    .shopify-section--header .Search[aria-hidden="false"] { transform: none; }
    .shopify-section--header .Search { z-index: 3; } /* above the open panel: search takes the panel's place without the panel closing */
    .Header--foundSearching .FoundPanel { visibility: hidden; transition: visibility 0s 160ms; }
    .shopify-section--header .Search__Inner { position: relative; padding: 12px 50px 36px; max-height: calc(100vh - var(--header-height, 92px)); }
    .shopify-section--header .Search__SearchBar { width: 520px; margin: 0 auto; }
    .shopify-section--header .Search__Form { position: relative; flex: 1 1 auto; padding-bottom: 10px; border-bottom: 1px solid var(--header-heading-color); color: var(--header-heading-color); }
    .shopify-section--header .Search__Form .Icon--search-desktop { width: 13px; height: 13px; }
    .shopify-section--header .Search__InputIconWrapper { top: 0; margin-right: 12px; color: inherit; line-height: 0; }
    .shopify-section--header .Search__Input { font-family: var(--heading-font-family); font-weight: 500; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: inherit; padding: 0; height: 1.4em; }
    .shopify-section--header .Search__Input::placeholder { color: transparent; }
    .FoundSearch__Hint { position: absolute; left: 25px; right: 0; top: 0; height: 1.4em; display: flex; align-items: center; gap: 0.3em; white-space: nowrap; overflow: hidden; pointer-events: none; font-family: var(--heading-font-family); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-color-light); }
    .shopify-section--header .Search__Input:not(:placeholder-shown) + .FoundSearch__Hint { display: none; }
    .FoundSearch__HintWords { display: grid; min-width: 0; }
    .FoundSearch__HintWord { grid-area: 1 / 1; opacity: 0; transform: translateY(0.6em); transition: opacity 420ms ease, transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1); }
    .FoundSearch__HintWord.is-active { opacity: 1; transform: none; }
    .FoundSearch__HintWord.is-leaving { opacity: 0; transform: translateY(-0.6em); }
    .shopify-section--header .Search__Close { position: absolute; top: 14px; right: 50px; color: var(--header-heading-color); line-height: 0; }
    .shopify-section--header .Search__Close svg { width: 15px; height: 15px; stroke-width: 1.5px; }
    .shopify-section--header .Search__Results { margin: 28px 0 0; }
    .shopify-section--header .Search__Results .PageLayout { display: block; margin: 0; }
    .shopify-section--header .Search__Results .PageLayout__Section { width: auto; max-width: none; margin: 0; }
    .shopify-section--header .Search__Results .PageLayout__Section--secondary { display: none; } /* pages and articles: the search page still lists them */
    .shopify-section--header .Search__Results .Segment__Title { display: flex; justify-content: space-between; align-items: baseline; padding: 0 0 18px; margin: 0; border: 0; }
    .shopify-section--header .Search__Results .Segment__Title .Heading { font-family: var(--heading-font-family); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-color-light); }
    .shopify-section--header .Search__Results .Segment__Title a.Heading { color: var(--header-heading-color); text-decoration: none; padding-bottom: 2px; border-bottom: 1px solid currentColor; }
    .FoundSearch__Row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; align-items: start; }
    .FoundSearch__Row .FoundPanel__Card { opacity: 0; animation: FoundPanel-rise 480ms cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i, 0) * 45ms); }
    .FoundSearch__Legacy { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .FoundNav__Roll > span, .FoundNav__Burger span, .FoundPanel, .FoundBackdrop, .FoundSearch__HintWord { transition: none; }
    .FoundSearch__Row .FoundPanel__Card { animation: none; opacity: 1; }
    .FoundPanel__Shelf.is-shown .FoundPanel__Card, .FoundPanel__Shelf.is-shown .FoundPanel__Article { animation: none; opacity: 1; }
    .FoundPanel__CardImg, .FoundPanel__ArticleImg { animation: none; }
  }
</style>

<script>
  (function () {
    var DESKTOP = window.matchMedia('(min-width: 1008px)');

    function init(header) {
      if (!header || header.__foundNav) return;
      var nav = header.querySelector('[data-found-nav]');
      var panel = header.querySelector('[data-found-panel]');
      if (!nav || !panel) return;
      var toggle = nav.querySelector('[data-found-toggle]');
      var groups = Array.prototype.slice.call(nav.querySelectorAll('[data-group]'));
      var warmed = false;

      function warm() {
        if (warmed) return;
        warmed = true;
        Array.prototype.forEach.call(panel.querySelectorAll('img[data-src]'), function (img) {
          var card = img.closest('.FoundPanel__Card, .FoundPanel__Article');
          var done = function () { if (card) card.classList.add('is-loaded'); };
          img.addEventListener('load', done);
          img.addEventListener('error', done);
          img.src = img.getAttribute('data-src');
          img.removeAttribute('data-src');
        });
      }

      // Analytics: one event when the panel opens, one per click inside it. Sent to GA4 through gtag (or the
      // data layer when gtag is absent) and to Shopify's customer events as a custom event for pixels.
      function track(name, data) {
        try { if (typeof window.gtag === 'function') window.gtag('event', name, data); else { window.dataLayer = window.dataLayer || []; window.dataLayer.push(Object.assign({ event: name }, data)); } } catch (e) {}
        try { if (window.Shopify && window.Shopify.analytics && window.Shopify.analytics.publish) window.Shopify.analytics.publish(name, data); } catch (e) {}
      }
      function labelOf(link) {
        var word = link && link.querySelector('.FoundNav__Roll > span');
        return (word || link) ? (word || link).textContent.trim() : '';
      }
      function activeLabel() { return labelOf(nav.querySelector('[data-group].is-active')); }

      // quick: a switch while the panel is already open crossfades instead of replaying the full stagger
      function show(key, quick) {
        panel.setAttribute('data-active', key);
        panel.classList.toggle('FoundPanel--quick', !!quick);
        groups.forEach(function (g) { g.classList.toggle('is-active', g.getAttribute('data-group') === key); });
        Array.prototype.forEach.call(panel.querySelectorAll('[data-for]'), function (el) { el.classList.remove('is-shown'); });
        void panel.offsetWidth; // restart the animation
        Array.prototype.forEach.call(panel.querySelectorAll('[data-for="' + key + '"]'), function (el) { el.classList.add('is-shown'); });
      }

      // Search and the panel share one sheet: with the panel open, search shows in its place and the panel
      // returns when search closes; hovering the quick links while search is showing brings the panel back.
      var searchEl = document.getElementById('Search');
      function searchIsOpen() { return !!searchEl && searchEl.getAttribute('aria-hidden') === 'false'; }
      function closeSearch() { var c = searchEl && searchEl.querySelector('[data-action="close-search"]'); if (searchIsOpen() && c) c.click(); }
      function setOpen(open) {
        var was = header.classList.contains('Header--foundOpen');
        if (!open) closeSearch();
        header.classList.toggle('Header--foundOpen', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        panel.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (open) { warm(); show(panel.getAttribute('data-active') || (groups[0] && groups[0].getAttribute('data-group')), false); }
        if (open && !was) track('found_menu_open', { menu_group: activeLabel() });
      }

      panel.addEventListener('click', function (e) {
        var a = e.target.closest('a');
        if (!a || !panel.contains(a)) return;
        var type = a.classList.contains('FoundPanel__Card') ? 'product' : a.classList.contains('FoundPanel__Article') ? 'article' : a.closest('.FoundPanel__Sub') ? 'section' : 'link';
        var name = a.querySelector('.FoundPanel__CardName, .FoundPanel__ArticleTitle');
        var row = a.closest('.FoundPanel__Shelf');
        track('found_menu_click', { menu_group: activeLabel(), item_type: type, item_name: (name ? name.textContent : a.textContent).trim().replace(/\s+/g, ' ').slice(0, 80), item_url: a.getAttribute('href'), position: row ? Array.prototype.indexOf.call(row.children, a) + 1 : undefined });
      });
      nav.addEventListener('click', function (e) {
        var a = e.target.closest('.FoundNav__QuickLink');
        if (a) track('found_menu_click', { menu_group: labelOf(a), item_type: 'quick_link', item_url: a.getAttribute('href') });
      });


      // Mirror the overlay's state onto the header, so the panel can step aside while search is showing.
      if (searchEl && window.MutationObserver) {
        new MutationObserver(function () { header.classList.toggle('Header--foundSearching', searchIsOpen()); }).observe(searchEl, { attributes: true, attributeFilter: ['aria-hidden'] });
      }

      toggle.addEventListener('click', function () {
        var opening = !header.classList.contains('Header--foundOpen');
        if (opening) closeSearch();
        setOpen(opening);
      });

      // Hovering the bar opens the panel; leaving the bar and panel closes it. Short delays so a cursor
      // passing through does not flash it, and a slip off the edge does not snap it shut. Mouse only.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        var hoverTimer = null;
        var later = function (fn, ms) { clearTimeout(hoverTimer); hoverTimer = setTimeout(function () { hoverTimer = null; fn(); }, ms); };
        // mousemove rather than mouseenter, so a page that loads under a resting cursor does not open by itself
        // Only the quick links and the burger open it, not the wordmark or the empty bar.
        var armOpen = function (e) {
          if (!e.movementX && !e.movementY) return; // the browser's own hover refresh, not the hand
          if (DESKTOP.matches && !hoverTimer && !header.classList.contains('Header--foundOpen')) later(function () { closeSearch(); setOpen(true); }, 120);
        };
        var quick = nav.querySelector('.FoundNav__Quick');
        if (quick) quick.addEventListener('mousemove', armOpen);
        toggle.addEventListener('mousemove', armOpen);
        header.addEventListener('mouseleave', function () { later(function () { setOpen(false); }, 220); });
        header.addEventListener('mouseenter', function () { clearTimeout(hoverTimer); hoverTimer = null; });
        var backdrop = header.querySelector('[data-found-backdrop]');
        if (backdrop) {
          backdrop.addEventListener('mouseenter', function () { later(function () { setOpen(false); }, 220); });
          backdrop.addEventListener('click', function () { setOpen(false); });
        }
      }
      groups.forEach(function (g) {
        g.addEventListener('mouseenter', function () { closeSearch(); show(g.getAttribute('data-group'), header.classList.contains('Header--foundOpen')); });
        g.addEventListener('focus', function () { show(g.getAttribute('data-group'), header.classList.contains('Header--foundOpen')); });
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
      document.addEventListener('click', function (e) { if (header.classList.contains('Header--foundOpen') && !header.contains(e.target)) setOpen(false); });

      // The search hint cycles through a few pieces while the overlay is open and empty.
      var hintWords = searchEl ? Array.prototype.slice.call(searchEl.querySelectorAll('.FoundSearch__HintWord')) : [];
      if (hintWords.length > 1) {
        var hintIndex = 0;
        setInterval(function () {
          if (!searchIsOpen()) return;
          var current = hintWords[hintIndex];
          hintIndex = (hintIndex + 1) % hintWords.length;
          current.classList.remove('is-active'); current.classList.add('is-leaving');
          hintWords[hintIndex].classList.add('is-active');
          setTimeout(function () { current.classList.remove('is-leaving'); }, 450);
        }, 3000);
      }

      // Transparency, every screen size: clear while the hero (or collection banner) is still under the header.
      // Measured against the first section after the hero when the hero is pinned, otherwise the hero's own bottom.
      // This script runs while the header is still being parsed, so the hero is looked up once the DOM is ready.
      function setupTransparency() {
        var transparentPage = getComputedStyle(document.documentElement).getPropertyValue('--header-is-transparent').trim() === '1';
        var hero = document.querySelector('.HeroSearch, .Slideshow, .PageHeader--withBackground');
        if (!transparentPage || !hero) return;
        var heroWrapper = hero.closest('.shopify-section') || hero;
        var pinned = getComputedStyle(heroWrapper).position === 'sticky';
        var after = heroWrapper.nextElementSibling;
        var ticking = false;
        var check = function () {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(function () {
            ticking = false;
            var edge = (pinned && after) ? after.getBoundingClientRect().top : hero.getBoundingClientRect().bottom;
            header.classList.toggle('Header--foundClear', edge > header.offsetHeight);
          });
        };
        window.addEventListener('scroll', check, { passive: true });
        window.addEventListener('resize', check);
        check();
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupTransparency);
      else setupTransparency();

      // Warm the product images once the page is idle, desktop only, so the first open is instant.
      if (DESKTOP.matches && !(window.matchMedia && window.matchMedia('(prefers-reduced-data: reduce)').matches)) {
        var idle = window.requestIdleCallback || function (cb) { setTimeout(cb, 1500); };
        window.addEventListener('load', function () { idle(warm, { timeout: 4000 }); });
      }

      header.__foundNav = { close: function () { setOpen(false); } };
    }

    Array.prototype.forEach.call(document.querySelectorAll('.Header--found'), init);
    document.addEventListener('shopify:section:load', function (event) { init(event.target.querySelector('.Header--found')); });
  })();
</script>
