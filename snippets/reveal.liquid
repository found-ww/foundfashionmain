{%- comment -%}
  Scroll reveal for homepage sections. Pairs with assets/reveal.js.
  The styles only apply once the script has added `reveal-enabled` to <html>,
  so without JavaScript nothing is ever hidden.
{%- endcomment -%}
<style>
  .reveal-enabled .Reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 900ms cubic-bezier(0.2, 0.7, 0.2, 1), transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  .reveal-enabled .Reveal.is-revealed {
    opacity: 1;
    transform: none;
  }

  /* Once revealed, release will-change and let the theme's own hover transitions take over. */
  .reveal-enabled .Reveal.is-revealed {
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-enabled .Reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
<script src="{{ 'reveal.js' | asset_url }}" defer></script>
