{%- comment -%}
  Hero with search
  ----------------
  A homepage hero built around a large search bar, inspired by cosmos.so.

  - The heading is "<prefix> <rotating phrase>", where each phrase is a "phrase" block
    with its own link and two product thumbnails. The prefix stays static so the H1 reads
    the same for search engines; only the rotating part is announced to screen readers.
  - The search bar is a real <form> that posts to the theme's search page, so it works
    before JavaScript loads. The placeholder cycles through the phrases with JS, but the
    first phrase is rendered server-side as the real placeholder attribute.
  - "Chip" blocks render quick links (brands, categories) under the search bar.
  - Rotation is skipped when the visitor prefers reduced motion.
{%- endcomment -%}

{%- liquid
  assign phrases = section.blocks | where: 'type', 'phrase'
  assign chips = section.blocks | where: 'type', 'chip'
  assign first_phrase = phrases | first
  assign search_label = 'search.general.input_placeholder' | t

  if first_phrase
    assign placeholder = section.settings.placeholder_prefix | append: ' ' | append: first_phrase.settings.text | strip
  else
    assign placeholder = search_label
  endif
-%}

<section id="section-{{ section.id }}"
         class="HeroSearch {% if section.settings.image %}HeroSearch--withImage{% endif %} {% if section.settings.image and section.settings.apply_overlay %}HeroSearch--overlay{% endif %} {% if section.settings.bar_style == 'glass' and section.settings.bar_shape != 'underline' %}HeroSearch--glass{% endif %} HeroSearch--shape-{{ section.settings.bar_shape | default: 'pill' }} {% if section.settings.content_alignment == 'left' %}HeroSearch--left{% endif %} {% if section.settings.full_height %}HeroSearch--full{% endif %}"
         data-section-id="{{ section.id }}"
         data-section-type="hero-search"
         data-rotate-interval="{{ section.settings.rotate_speed | times: 1000 }}"
         data-placeholder-prefix="{{ section.settings.placeholder_prefix | escape }}">

  {%- if section.settings.image -%}
    <div class="HeroSearch__Background" aria-hidden="true">
      <img class="HeroSearch__BackgroundImage"
           src="{{ section.settings.image | img_url: '1800x' }}"
           srcset="{{ section.settings.image | img_url: '800x' }} 800w, {{ section.settings.image | img_url: '1200x' }} 1200w, {{ section.settings.image | img_url: '1800x' }} 1800w, {{ section.settings.image | img_url: '2400x' }} 2400w"
           sizes="100vw"
           fetchpriority="high"
           loading="eager"
           alt="">
    </div>
  {%- endif -%}

  <div class="HeroSearch__Inner Container">
    <div class="HeroSearch__Head {% if section.settings.heading_panel %}HeroSearch__Head--panel{% endif %}">
    {%- if section.settings.subheading != blank -%}
      <p class="HeroSearch__SubHeading Heading u-h6" {% if section.settings.subheading_2 != blank %}data-rotating-sub{% endif %}>
        <span class="HeroSearch__SubLine is-active">{{ section.settings.subheading | escape }}</span>
        {%- if section.settings.subheading_2 != blank -%}
          <span class="HeroSearch__SubLine" aria-hidden="true">{{ section.settings.subheading_2 | escape }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- liquid
      assign heading_class = 'HeroSearch__Heading Heading'
      if phrases.size > 0 and section.settings.phrases_in_heading
        assign heading_class = heading_class | append: ' HeroSearch__Heading--withPhrase'
      endif
    -%}
    {%- if request.page_type == 'index' -%}
      <h1 class="{{ heading_class }}">
    {%- else -%}
      <h2 class="{{ heading_class }}">
    {%- endif -%}
      <span class="HeroSearch__HeadingPrefix">{{ section.settings.heading | escape }}</span>

      {%- if phrases.size > 0 and section.settings.phrases_in_heading -%}
        <span class="HeroSearch__Phrases" aria-live="polite" aria-atomic="true">
          {%- for block in phrases -%}
            {%- assign link = block.settings.link -%}
            {%- if link == blank -%}
              {%- assign encoded_phrase = block.settings.text | url_encode -%}
              {%- assign link = routes.search_url | append: '?q=' | append: encoded_phrase | append: '&type=product' -%}
            {%- endif -%}
            <a href="{{ link }}"
               class="HeroSearch__Phrase {% if forloop.first %}is-active{% endif %}"
               data-phrase="{{ block.settings.text | escape }}"
               {% unless forloop.first %}aria-hidden="true" tabindex="-1"{% endunless %}
               {{ block.shopify_attributes }}>
              <span class="HeroSearch__PhraseText">{{ block.settings.text | escape }}</span>
            </a>
          {%- endfor -%}
        </span>
      {%- endif -%}
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </h2>
    {%- endif -%}
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="HeroSearch__Form">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">

      <label for="HeroSearch-{{ section.id }}-input" class="u-visually-hidden">{{ search_label }}</label>

      <div class="HeroSearch__Bar">
        {%- if section.settings.bar_style == 'glass' and section.settings.bar_shape != 'underline' -%}
          <span class="HeroSearch__BarRim" aria-hidden="true"></span>
        {%- endif -%}
        <span class="HeroSearch__BarIcon" aria-hidden="true">{%- render 'icon' with 'search-desktop' -%}</span>

        <span class="HeroSearch__Field">
          <input id="HeroSearch-{{ section.id }}-input"
                 class="HeroSearch__Input"
                 type="search"
                 name="q"
                 placeholder="{{ placeholder | escape }}"
                 autocomplete="off"
                 autocorrect="off"
                 autocapitalize="off"
                 spellcheck="false">
          {%- if phrases.size > 1 -%}
            {%- comment -%}
              Animated hint: "Search for" stays put while the suggestion underneath it
              slides through the phrases. Decorative; the real placeholder is on the
              input for screen readers and for when JavaScript is off.
            {%- endcomment -%}
            <span class="HeroSearch__Hint" aria-hidden="true">
              <span class="HeroSearch__HintPrefix">{{ section.settings.placeholder_prefix | escape }}</span>
              <span class="HeroSearch__HintWords">
                {%- for block in phrases -%}
                  <span class="HeroSearch__HintWord {% if forloop.first %}is-active{% endif %}">{{ block.settings.text | escape }}</span>
                {%- endfor -%}
              </span>
            </span>
          {%- endif -%}
        </span>

        <button type="submit" class="HeroSearch__Submit" aria-label="{{ 'search.general.title' | t }}">
          {%- render 'icon' with 'arrow-right' -%}
        </button>
      </div>
    </form>

    {%- if chips.size > 0 -%}
      <nav class="HeroSearch__Chips" aria-label="{{ section.settings.chips_label | escape }}">
        {%- if section.settings.chips_label != blank -%}
          <span class="HeroSearch__ChipsLabel Text--subdued">{{ section.settings.chips_label | escape }}</span>
        {%- endif -%}
        {%- for block in chips -%}
          <a href="{{ block.settings.link }}" class="HeroSearch__Chip" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="HeroSearch__Button Button Button--primary">{{ section.settings.button_text | escape }}</a>
    {%- endif -%}
  </div>
</section>

<style>
  #section-{{ section.id }} {
    --hero-text: {{ section.settings.text_color }};
    --hero-text-rgb: {{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }};
    --hero-background: {{ section.settings.background }};
    --hero-bar-background: {{ section.settings.bar_background }};
    --hero-bar-background-rgb: {{ section.settings.bar_background | color_extract: 'red' }}, {{ section.settings.bar_background | color_extract: 'green' }}, {{ section.settings.bar_background | color_extract: 'blue' }};
    --hero-bar-text: {{ section.settings.bar_text_color }};
    --hero-bar-text-rgb: {{ section.settings.bar_text_color | color_extract: 'red' }}, {{ section.settings.bar_text_color | color_extract: 'green' }}, {{ section.settings.bar_text_color | color_extract: 'blue' }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-accent-text: {{ section.settings.accent_text_color }};
    --hero-min-height: {{ section.settings.min_height }}vh;
  }

  .HeroSearch {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--hero-min-height);
    padding: 80px 0 64px;
    background: var(--hero-background);
    color: var(--hero-text);
    overflow: hidden;
    isolation: isolate;
  }

  /*
    Full-screen height: the same formula the theme's full-screen slideshow uses,
    so the hero fills the window below the announcement bar exactly as the old
    hero did. Falls back to 100vh before theme.js has measured the window.
  */
  .HeroSearch--full {
    min-height: 100vh;
  }

  @supports (--css: variables) {
    .js .HeroSearch--full {
      min-height: calc(var(--window-height, 100vh) - (var(--header-height, 0px) * var(--header-is-not-transparent, 0)) - var(--announcement-bar-height, 0px));
    }
  }

  .HeroSearch__Background {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .HeroSearch__BackgroundImage {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  .HeroSearch--overlay .HeroSearch__Background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.45) 100%);
  }

  .HeroSearch__Inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 960px;
    text-align: center;
  }

  /*
    Entrance: the photo is already there; the words, the bar and the chips rise
    in one after another, once, on load. Pure CSS so it needs no script.
  */
  @keyframes HeroSearch-rise {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: none; }
  }

  .HeroSearch__Head,
  .HeroSearch__Form,
  .HeroSearch__Chips,
  .HeroSearch__Button {
    animation: HeroSearch-rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .HeroSearch__Head   { animation-delay: 80ms; }
  .HeroSearch__Form   { animation-delay: 220ms; }
  .HeroSearch__Chips  { animation-delay: 360ms; }
  .HeroSearch__Button { animation-delay: 460ms; }

  .HeroSearch__Head {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 32px;
  }

  .HeroSearch__Head .HeroSearch__Heading {
    margin-bottom: 0;
  }

  /* Soft pocket behind the headline so the words sit on a calm patch of the photo. */
  .HeroSearch__Head--panel {
    width: auto;
    max-width: 100%;
    padding: 22px 28px 26px;
    border-radius: 28px;
    background: rgba(20, 18, 16, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(24px) saturate(120%);
    backdrop-filter: blur(24px) saturate(120%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .HeroSearch__Head--panel {
      background: rgba(20, 18, 16, 0.45);
    }
  }

  .HeroSearch__SubHeading {
    display: grid;
    margin-bottom: 18px;
    color: var(--hero-text);
    opacity: 0.75;
  }

  /* Rotating sub-heading lines share one cell and crossfade. */
  .HeroSearch__SubLine {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 600ms ease, transform 600ms ease;
  }

  .HeroSearch__SubLine.is-active {
    opacity: 1;
    transform: none;
  }

  .HeroSearch__SubLine.is-leaving {
    opacity: 0;
    transform: translateY(-6px);
  }

  /* Field wrapper so the animated hint can sit over the input. */
  .HeroSearch__Field {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
  }

  .HeroSearch__Hint {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
    overflow: hidden;
    pointer-events: none;
    color: rgba(var(--hero-bar-text-rgb), 0.5);
    font-family: var(--text-font-family);
    font-size: 15px;
  }

  .HeroSearch__Bar--hinted .HeroSearch__Hint {
    display: flex;
  }

  .HeroSearch__Bar--hinted .HeroSearch__Input::placeholder {
    color: transparent;
  }

  .HeroSearch__Bar--hinted .HeroSearch__Input:focus + .HeroSearch__Hint,
  .HeroSearch__Bar--hinted .HeroSearch__Input:not(:placeholder-shown) + .HeroSearch__Hint {
    display: none;
  }

  .HeroSearch__Bar--hinted .HeroSearch__Input:focus::placeholder {
    color: rgba(var(--hero-bar-text-rgb), 0.5);
  }

  .HeroSearch__HintWords {
    display: grid;
    min-width: 0;
  }

  .HeroSearch__HintWord {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.6em);
    transition: opacity 420ms ease, transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .HeroSearch__HintWord.is-active {
    opacity: 1;
    transform: none;
  }

  .HeroSearch__HintWord.is-leaving {
    opacity: 0;
    transform: translateY(-0.6em);
  }

  .HeroSearch__Heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 0 0 32px;
    color: var(--hero-text);
    font-size: clamp(34px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Headline matches the store's other headings: theme heading font, capitals, 0.2em tracking. */
  .HeroSearch .HeroSearch__Heading {
    font-family: var(--heading-font-family);
    font-weight: var(--heading-font-weight);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .HeroSearch__Phrases {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 1.25em;
    justify-items: center;
  }

  .HeroSearch__Phrase {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 320ms ease, transform 320ms ease;
    pointer-events: none;
  }

  .HeroSearch__Phrase.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .HeroSearch__Phrase.is-leaving {
    opacity: 0;
    transform: translateY(-10px);
  }

  .HeroSearch__PhraseText {
    border-bottom: 2px solid rgba(var(--hero-text-rgb), 0.35);
    transition: border-color 150ms ease;
  }

  .HeroSearch__Phrase:hover .HeroSearch__PhraseText {
    border-color: var(--hero-text);
  }

  .HeroSearch__Form {
    width: 100%;
    max-width: 520px;
  }

  .HeroSearch__Bar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 5px 5px 5px 18px;
    border-radius: 999px;
    background: var(--hero-bar-background);
    color: var(--hero-bar-text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 12px 32px rgba(0, 0, 0, 0.12);
    transition: box-shadow 200ms ease, transform 200ms ease;
  }

  .HeroSearch__Bar:focus-within {
    box-shadow: 0 0 0 2px var(--hero-bar-background), 0 0 0 4px var(--hero-accent), 0 12px 32px rgba(0, 0, 0, 0.16);
  }

  .HeroSearch__BarIcon {
    display: inline-flex;
    flex-shrink: 0;
    opacity: 0.6;
  }

  .HeroSearch__BarIcon svg {
    width: 17px;
    height: 17px;
  }

  .HeroSearch__Input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--hero-bar-text);
    font-family: var(--text-font-family);
    font-size: 15px;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .HeroSearch__Input::placeholder {
    color: rgba(var(--hero-bar-text-rgb), 0.5);
    opacity: 1;
  }

  .HeroSearch__Input::-webkit-search-decoration,
  .HeroSearch__Input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .HeroSearch__Submit {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--hero-accent);
    color: var(--hero-accent-text);
    cursor: pointer;
    transition: transform 150ms ease, opacity 150ms ease;
  }

  .HeroSearch__Submit svg {
    width: 14px;
    height: 14px;
  }

  .HeroSearch__Submit:hover { transform: scale(1.05); }
  .HeroSearch__Submit:focus-visible { outline: 2px solid var(--hero-accent); outline-offset: 2px; }

  .HeroSearch__Chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 16px;
    max-width: 560px;
  }

  .HeroSearch__ChipsLabel {
    margin-right: 4px;
    font-size: 12px;
    color: var(--hero-text);
    opacity: 0.7;
  }

  .HeroSearch__Chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border: 1px solid rgba(var(--hero-text-rgb), 0.3);
    border-radius: 999px;
    color: var(--hero-text);
    font-size: 12px;
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
  }

  .HeroSearch__Chip:hover,
  .HeroSearch__Chip:focus-visible {
    background: var(--hero-text);
    border-color: var(--hero-text);
    color: var(--hero-background);
  }

  .HeroSearch__Button {
    margin-top: 28px;
  }

  /*
    Glass variant: a clear frosted slab over the photo. Low white tint with a
    diagonal sheen, heavy blur, bright top edge, and the section text colour
    for the type so it reads like etched glass rather than a white pill.
  */
  .HeroSearch--glass .HeroSearch__Bar {
    position: relative;
    overflow: hidden;
    color: var(--hero-text);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 255, 255, 0.12) 55%, rgba(255, 255, 255, 0.22) 100%);
    -webkit-backdrop-filter: blur(28px) saturate(170%);
    backdrop-filter: blur(28px) saturate(170%);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.75),
      inset 0 -1px 0 rgba(255, 255, 255, 0.12),
      inset 0 0 24px rgba(255, 255, 255, 0.08),
      0 18px 44px rgba(0, 0, 0, 0.24);
    transition:
      transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 520ms ease,
      border-color 520ms ease,
      background 800ms ease,
      -webkit-backdrop-filter 800ms ease,
      backdrop-filter 800ms ease;
  }

  /* Specular highlight across the top half of the slab. */
  .HeroSearch--glass .HeroSearch__Bar::before {
    content: '';
    position: absolute;
    inset: 0 0 50%;
    border-radius: inherit;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0));
    pointer-events: none;
    transition: opacity 800ms ease;
  }

  /*
    Hover / focus: the slab lifts a few pixels and the frost clears so the photo
    behind it comes into focus, while a thin highlight travels round the rim.
    Deliberately slow: the lift takes half a second, the clear most of a second.
  */
  .HeroSearch--glass .HeroSearch__Bar:hover,
  .HeroSearch--glass .HeroSearch__Bar:focus-within {
    transform: translateY(-3px);
    -webkit-backdrop-filter: blur(6px) saturate(130%);
    backdrop-filter: blur(6px) saturate(130%);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.05) 55%, rgba(255, 255, 255, 0.1) 100%);
    border-color: rgba(255, 255, 255, 0.9);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(255, 255, 255, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.2),
      0 26px 56px rgba(0, 0, 0, 0.3);
  }

  .HeroSearch--glass .HeroSearch__Bar:hover::before,
  .HeroSearch--glass .HeroSearch__Bar:focus-within::before {
    opacity: 0.4;
  }

  .HeroSearch--glass .HeroSearch__Bar:hover .HeroSearch__Input,
  .HeroSearch--glass .HeroSearch__Bar:focus-within .HeroSearch__Input {
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .HeroSearch--glass .HeroSearch__Bar:hover .HeroSearch__Input::placeholder,
  .HeroSearch--glass .HeroSearch__Bar:focus-within .HeroSearch__Input::placeholder {
    color: var(--hero-text);
  }

  .HeroSearch--glass .HeroSearch__Bar:focus-within {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(255, 255, 255, 0.3),
      0 0 0 3px rgba(255, 255, 255, 0.22),
      0 26px 56px rgba(0, 0, 0, 0.3);
  }

  /* Rim highlight: a short bright arc that circles the bar while hovered. */
  .HeroSearch__BarRim {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms ease;
    background: conic-gradient(from var(--hero-rim-angle, 0deg), rgba(255, 255, 255, 0) 0deg, rgba(255, 255, 255, 0.9) 60deg, rgba(255, 255, 255, 0) 120deg, rgba(255, 255, 255, 0) 360deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  @property --hero-rim-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes HeroSearch-rim {
    to { --hero-rim-angle: 360deg; }
  }

  .HeroSearch--glass .HeroSearch__Bar:hover .HeroSearch__BarRim,
  .HeroSearch--glass .HeroSearch__Bar:focus-within .HeroSearch__BarRim {
    opacity: 1;
    animation: HeroSearch-rim 4s linear infinite;
  }

  .HeroSearch--glass .HeroSearch__Input,
  .HeroSearch--glass .HeroSearch__BarIcon {
    position: relative;
    color: var(--hero-text);
  }

  .HeroSearch--glass .HeroSearch__BarIcon {
    opacity: 0.8;
  }

  .HeroSearch--glass .HeroSearch__Input::placeholder {
    color: rgba(var(--hero-text-rgb), 0.72);
  }

  .HeroSearch--glass .HeroSearch__Submit {
    position: relative;
    background: rgba(255, 255, 255, 0.92);
    color: var(--hero-accent);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    transition: transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1), background 520ms ease;
  }

  .HeroSearch--glass .HeroSearch__Submit svg {
    transition: transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .HeroSearch--glass .HeroSearch__Bar:hover .HeroSearch__Submit,
  .HeroSearch--glass .HeroSearch__Bar:focus-within .HeroSearch__Submit {
    transform: scale(1.08);
    background: #ffffff;
  }

  .HeroSearch--glass .HeroSearch__Bar:hover .HeroSearch__Submit svg,
  .HeroSearch--glass .HeroSearch__Bar:focus-within .HeroSearch__Submit svg {
    transform: translateX(2px);
  }

  .HeroSearch--glass .HeroSearch__Chip {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
  }

  .HeroSearch--glass .HeroSearch__ChipsLabel {
    opacity: 0.85;
  }

  /* Browsers without backdrop-filter get a darker tint so the light text stays readable. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .HeroSearch--glass .HeroSearch__Bar,
    .HeroSearch--glass .HeroSearch__Bar:hover,
    .HeroSearch--glass .HeroSearch__Bar:focus-within {
      background: rgba(20, 18, 16, 0.6);
    }
    .HeroSearch--glass .HeroSearch__Chip {
      background: rgba(20, 18, 16, 0.4);
    }
  }

  @media screen and (min-width: 641px) {
    .HeroSearch { padding: 110px 0 90px; }
    .HeroSearch__Heading { margin-bottom: 40px; }
    .HeroSearch__Head { margin-bottom: 40px; }
    .HeroSearch__Head--panel { padding: 28px 44px 34px; border-radius: 36px; }
    .HeroSearch__Bar { height: 54px; padding: 6px 6px 6px 22px; }
    .HeroSearch__Input, .HeroSearch__Hint { font-size: 16px; }
    .HeroSearch--left .HeroSearch__Bar { height: 46px; padding: 5px 5px 5px 18px; }
    .HeroSearch--left .HeroSearch__Input, .HeroSearch--left .HeroSearch__Hint { font-size: 14px; }
    .HeroSearch--left .HeroSearch__Submit { width: 36px; height: 36px; }
    .HeroSearch--left .HeroSearch__Submit svg { width: 13px; height: 13px; }
    .HeroSearch__BarIcon svg { width: 18px; height: 18px; }
    .HeroSearch__Submit { width: 42px; height: 42px; }
    .HeroSearch__Submit svg { width: 15px; height: 15px; }
    .HeroSearch__Chip { font-size: 13px; }
  }

  /*
    Left layout: content sits bottom-left the way Forma Studio sets its hero,
    with the headline doing the work and the bar and chips tucked under it.
  */
  .HeroSearch--left {
    align-items: flex-end;
    justify-content: flex-start;
    padding-top: 160px;
  }

  .HeroSearch--left .HeroSearch__Inner {
    align-items: flex-start;
    max-width: 1180px;
    text-align: left;
  }

  .HeroSearch--left .HeroSearch__Head,
  .HeroSearch--left .HeroSearch__Heading {
    align-items: flex-start;
  }

  .HeroSearch--left .HeroSearch__SubHeading {
    letter-spacing: 0;
    text-transform: none;
    font-size: 14px;
    max-width: 34ch;
    line-height: 1.5;
    opacity: 0.85;
  }

  .HeroSearch--left .HeroSearch__Heading {
    font-size: clamp(40px, 7.2vw, 96px);
    line-height: 0.98;
    gap: 8px;
  }

  /* Forma-style: when a phrase rotates, the lead-in is small and the product name is the headline. */
  .HeroSearch--left .HeroSearch__Heading--withPhrase .HeroSearch__HeadingPrefix {
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.3;
    opacity: 0.9;
  }

  /* Single-line headline (no rotating phrase): a touch smaller so it breaks into two clean lines. */
  .HeroSearch--left .HeroSearch__Heading:not(.HeroSearch__Heading--withPhrase) {
    font-size: clamp(26px, 3.2vw, 45px);
    line-height: 1.2;
  }

  .HeroSearch--left .HeroSearch__Heading:not(.HeroSearch__Heading--withPhrase) .HeroSearch__HeadingPrefix {
    max-width: 24ch;
    text-wrap: balance;
  }

  .HeroSearch--left .HeroSearch__Phrases {
    justify-items: start;
  }

  .HeroSearch--left .HeroSearch__Form {
    max-width: 380px;
  }

  .HeroSearch--left .HeroSearch__Bar {
    height: 44px;
    padding: 4px 4px 4px 16px;
  }

  .HeroSearch--left .HeroSearch__Input,
  .HeroSearch--left .HeroSearch__Hint {
    font-size: 14px;
  }

  .HeroSearch--left .HeroSearch__Submit {
    width: 36px;
    height: 36px;
  }

  .HeroSearch--left .HeroSearch__Submit svg {
    width: 13px;
    height: 13px;
  }

  .HeroSearch--left .HeroSearch__Chips {
    justify-content: flex-start;
  }

  @media screen and (min-width: 641px) {
    .HeroSearch--left { padding-top: 200px; padding-bottom: 72px; }
    .HeroSearch--left .HeroSearch__Head { margin-bottom: 32px; }
  }

  /*
    Bar shapes. Pill is the default. Square takes the theme's own button radius.
    Underline drops the box altogether: a thin rule, tracked capitals and an
    arrow, the way the store sets its labels and links.
  */
  .HeroSearch--shape-square .HeroSearch__Bar,
  .HeroSearch--shape-square .HeroSearch__Submit,
  .HeroSearch--shape-square .HeroSearch__BarRim {
    border-radius: 2px;
  }

  .HeroSearch--shape-underline .HeroSearch__Form {
    max-width: 420px;
  }

  .HeroSearch--shape-underline .HeroSearch__Bar {
    height: auto;
    padding: 0 0 12px;
    gap: 14px;
    border: 0;
    border-bottom: 1px solid rgba(var(--hero-text-rgb), 0.55);
    border-radius: 0;
    background: transparent;
    color: var(--hero-text);
    box-shadow: none;
    transition: border-color 400ms ease;
  }

  .HeroSearch--shape-underline .HeroSearch__Bar:hover,
  .HeroSearch--shape-underline .HeroSearch__Bar:focus-within {
    border-bottom-color: var(--hero-text);
  }

  .HeroSearch--shape-underline .HeroSearch__BarIcon {
    opacity: 0.85;
  }

  .HeroSearch--shape-underline .HeroSearch__BarIcon svg {
    width: 15px;
    height: 15px;
  }

  .HeroSearch--shape-underline .HeroSearch__Field {
    height: 28px;
  }

  .HeroSearch--shape-underline .HeroSearch__Input,
  .HeroSearch--shape-underline .HeroSearch__Hint {
    color: var(--hero-text);
    font-family: var(--heading-font-family);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .HeroSearch--shape-underline .HeroSearch__Input::placeholder,
  .HeroSearch--shape-underline .HeroSearch__Hint {
    color: rgba(var(--hero-text-rgb), 0.75);
  }

  .HeroSearch--shape-underline .HeroSearch__Bar--hinted .HeroSearch__Input::placeholder {
    color: transparent;
  }

  .HeroSearch--shape-underline .HeroSearch__Bar--hinted .HeroSearch__Input:focus::placeholder {
    color: rgba(var(--hero-text-rgb), 0.75);
  }

  .HeroSearch--shape-underline .HeroSearch__Submit {
    width: 28px;
    height: 28px;
    background: transparent;
    color: var(--hero-text);
    box-shadow: none;
    border-radius: 0;
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .HeroSearch--shape-underline .HeroSearch__Submit svg {
    width: 12px;
    height: 12px;
  }

  .HeroSearch--shape-underline .HeroSearch__Bar:hover .HeroSearch__Submit,
  .HeroSearch--shape-underline .HeroSearch__Bar:focus-within .HeroSearch__Submit {
    transform: translateX(4px);
  }

  .HeroSearch--shape-underline .HeroSearch__Submit:focus-visible {
    outline: 1px solid var(--hero-text);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .HeroSearch__Head,
    .HeroSearch__Form,
    .HeroSearch__Chips,
    .HeroSearch__Button { animation: none; }
    .HeroSearch__Phrase,
    .HeroSearch__Bar,
    .HeroSearch__Bar::before,
    .HeroSearch__Submit,
    .HeroSearch__Submit svg,
    .HeroSearch__Chip { transition: none; }
    .HeroSearch__BarRim { display: none; }
    .HeroSearch--glass .HeroSearch__Bar:hover,
    .HeroSearch--glass .HeroSearch__Bar:focus-within { transform: none; }
  }
</style>

<script>
  (function () {
    var SELECTOR = '[data-section-type="hero-search"]';

    function setup(section) {
      if (!section || section.__heroSearch) return;

      var phrases = Array.prototype.slice.call(section.querySelectorAll('.HeroSearch__Phrase'));
      var input = section.querySelector('.HeroSearch__Input');
      var interval = parseInt(section.getAttribute('data-rotate-interval'), 10) || 3000;
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var timers = [];

      // Generic stacked-rotation helper: one element visible at a time, the rest wait.
      function rotate(items, every, offset, onChange) {
        if (items.length < 2) return;
        var i = 0;
        timers.push(window.setTimeout(function () {
          timers.push(window.setInterval(function () {
            if (document.hidden) return;
            var cur = items[i], next = items[(i + 1) % items.length];
            cur.classList.remove('is-active'); cur.classList.add('is-leaving');
            window.setTimeout(function () { cur.classList.remove('is-leaving'); }, 650);
            next.classList.add('is-active');
            i = (i + 1) % items.length;
            if (onChange) onChange(next);
          }, every));
        }, offset));
      }

      if (reduceMotion) return;

      // Sub-heading: "We find what others can't" / "Curated for those who know".
      var subLines = Array.prototype.slice.call(section.querySelectorAll('.HeroSearch__SubLine'));
      rotate(subLines, 4200, 2100);

      // Search hint: "Search for" stays, the suggestion beneath it cycles on its own
      // rhythm so it drifts away from the headline rather than mirroring it.
      var bar = section.querySelector('.HeroSearch__Bar');
      var hintWords = Array.prototype.slice.call(section.querySelectorAll('.HeroSearch__HintWord'));
      var hintPrefix = section.getAttribute('data-placeholder-prefix') || '';
      if (bar && hintWords.length > 1 && input) {
        bar.classList.add('HeroSearch__Bar--hinted');
        // Start one step ahead of the headline so the two never show the same word.
        hintWords[0].classList.remove('is-active');
        hintWords[1].classList.add('is-active');
        hintWords.push(hintWords.shift());
        rotate(hintWords, 2600, 1300, function (word) {
          // Keep the real placeholder honest for when the field is focused.
          input.placeholder = (hintPrefix + ' ' + word.textContent).trim();
        });
      }

      if (phrases.length < 2) {
        section.__heroSearch = { stop: function () { timers.forEach(clearTimeout); timers.forEach(clearInterval); }, start: function () {} };
        return;
      }

      var index = 0;
      var timer = null;
      var paused = false;

      function show(next) {
        var current = phrases[index];
        current.classList.remove('is-active');
        current.classList.add('is-leaving');
        current.setAttribute('aria-hidden', 'true');
        current.setAttribute('tabindex', '-1');

        window.setTimeout(function () { current.classList.remove('is-leaving'); }, 350);

        var target = phrases[next];
        target.classList.add('is-active');
        target.removeAttribute('aria-hidden');
        target.removeAttribute('tabindex');
        index = next;
      }

      function tick() {
        if (!paused && !document.hidden) show((index + 1) % phrases.length);
      }

      function start() {
        if (timer) return;
        timer = window.setInterval(tick, interval);
      }

      function stop() {
        timers.forEach(clearTimeout); timers.forEach(clearInterval); timers = [];
        if (!timer) return;
        window.clearInterval(timer);
        timer = null;
      }

      // Pause while the visitor is hovering or focused on the rotating phrase so the link
      // they are about to click does not disappear.
      var phraseWrap = section.querySelector('.HeroSearch__Phrases');
      phraseWrap.addEventListener('mouseenter', function () { paused = true; });
      phraseWrap.addEventListener('mouseleave', function () { paused = false; });
      phraseWrap.addEventListener('focusin', function () { paused = true; });
      phraseWrap.addEventListener('focusout', function () { paused = false; });

      start();

      section.__heroSearch = { stop: stop, start: start };
    }

    function teardown(section) {
      if (section && section.__heroSearch) {
        section.__heroSearch.stop();
        delete section.__heroSearch;
      }
    }

    Array.prototype.forEach.call(document.querySelectorAll(SELECTOR), setup);

    // Theme editor hooks
    document.addEventListener('shopify:section:load', function (event) {
      setup(event.target.querySelector(SELECTOR));
    });
    document.addEventListener('shopify:section:unload', function (event) {
      teardown(event.target.querySelector(SELECTOR));
    });
  })();
</script>

